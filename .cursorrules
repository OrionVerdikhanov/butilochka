## 🧪 Error Handling

### Async/Await Pattern
```typescript
// ✅ Proper error handling with try-catch-finally
const loadPlayers = async () => {
  try {
    setIsLoading(true);
    const data = await playerRepository.loadPlayers();
    setPlayers(data);
  } catch (error) {
    console.error('Failed to load players:', error);
    setError('Could not load players. Please try again.');
    // Optionally show user notification
  } finally {
    setIsLoading(false);
  }
};

// ✅ Validation before operations
const addPlayer = async (player: Partial<Player>) => {
  const validation = appService.validatePlayer(player);
  
  if (!validation.isValid) {
    throw new Error(validation.errors.join(', '));
  }
  
  await playerRepository.addPlayer(player as Player);
};
```

