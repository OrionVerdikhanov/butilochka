## 🔷 TypeScript Guidelines

### Strict Mode Rules
```typescript
// ✅ GOOD - Explicit types
interface Player {
  id: string;
  name: string;
  gender: 'M' | 'F';
  likes: number;
}

function processPlayer(player: Player): ProcessedPlayer {
  return { ...player, processed: true };
}

// ❌ BAD - Using 'any'
function processPlayer(player: any): any {
  return player;
}

// ✅ GOOD - Proper typing for async
async function loadData(): Promise<Player[]> {
  try {
    const data = await api.fetchPlayers();
    return data;
  } catch (error) {
    console.error('Failed to load:', error);
    throw error;
  }
}

// ✅ GOOD - Union types
type GameMode = 'wishes' | 'dating';
type LoadingState = 'idle' | 'loading' | 'success' | 'error';

// ✅ GOOD - Generic constraints
function findById<T extends { id: string }>(items: T[], id: string): T | null {
  return items.find(item => item.id === id) || null;
}

// ✅ GOOD - Const assertions for immutable data
const ANIMATION_CONFIG = {
  DURATION: 300,
  EASING: 'ease-in-out',
} as const;
```

### Interface vs Type
```typescript
// Use interface for object shapes (extendable)
interface Player {
  id: string;
  name: string;
}

// Use type for unions, intersections, primitives
type GameMode = 'wishes' | 'dating';
type PlayerWithStats = Player & { stats: GameStats };
```

### JSDoc Comments
```typescript
/**
 * Calculate rotation angle for target player
 * 
 * @param targetIndex - Index of target player in array
 * @param totalPlayers - Total number of players
 * @returns Rotation angle in degrees
 * 
 * @example
 * ```typescript
 * const angle = calculateRotationAngle(3, 8); // Returns: 135
 * ```
 */
function calculateRotationAngle(targetIndex: number, totalPlayers: number): number {
  return (targetIndex * 360) / totalPlayers;
}
```

