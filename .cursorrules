## 💻 Coding Standards

### Component Structure

```typescript
import React, { useState, useCallback, useEffect, useMemo } from 'react';
import { View, Text, StyleSheet } from 'react-native';

// 1. Props interface with JSDoc
interface ComponentNameProps {
  /** Description of prop */
  title: string;
  /** Callback handler */
  onPress: () => void;
  /** Optional prop */
  variant?: 'primary' | 'secondary';
}

/**
 * Component description
 * @param props - Component properties
 * @returns JSX element
 */
export function ComponentName({ title, onPress, variant = 'primary' }: ComponentNameProps) {
  // 2. State declarations
  const [isActive, setIsActive] = useState(false);

  // 3. Refs
  const animationRef = useRef(new Animated.Value(0)).current;

  // 4. Memoized values (useMemo)
  const computedValue = useMemo(() => {
    return expensiveCalculation(title);
  }, [title]);

  // 5. Callbacks (useCallback)
  const handlePress = useCallback(() => {
    setIsActive(true);
    onPress();
  }, [onPress]);

  // 6. Effects (useEffect) with cleanup
  useEffect(() => {
    const subscription = subscribeToEvent();
    return () => subscription.unsubscribe();
  }, []);

  // 7. Render
  return (
    <View style={styles.container}>
      <Text style={styles.title}>{title}</Text>
    </View>
  );
}

// 8. Memoization for performance (if needed)
export default React.memo(ComponentName);

// 9. Styles at bottom
const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 16,
  },
  title: {
    fontSize: 18,
    fontWeight: '600',
  },
});
```

### Custom Hook Structure

```typescript
import { useState, useCallback, useEffect } from 'react';

/**
 * Hook parameters interface
 */
interface UseHookNameProps {
  initialValue: string;
  onComplete?: () => void;
}

/**
 * Hook return type interface
 */
interface UseHookNameReturn {
  value: string;
  isLoading: boolean;
  updateValue: (newValue: string) => void;
  reset: () => void;
}

/**
 * Custom hook description with usage example
 * 
 * @example
 * ```typescript
 * const { value, isLoading, updateValue } = useHookName({
 *   initialValue: 'test',
 *   onComplete: () => console.log('Done')
 * });
 * ```
 */
export function useHookName({
  initialValue,
  onComplete
}: UseHookNameProps): UseHookNameReturn {
  const [value, setValue] = useState(initialValue);
  const [isLoading, setIsLoading] = useState(false);

  const updateValue = useCallback((newValue: string) => {
    setValue(newValue);
    onComplete?.();
  }, [onComplete]);

  const reset = useCallback(() => {
    setValue(initialValue);
  }, [initialValue]);

  return {
    value,
    isLoading,
    updateValue,
    reset,
  };
}
```

### Service/Repository Structure

```typescript
/**
 * Service class with clear responsibilities
 */
export class ServiceName {
  constructor(private repository: RepositoryInterface) {}

  /**
   * Public methods - business logic
   */
  async performAction(data: DataType): Promise<Result> {
    // 1. Validation
    this.validateData(data);

    // 2. Business logic
    const processed = await this.processData(data);

    // 3. Persistence
    await this.repository.save(processed);

    return processed;
  }

  /**
   * Private methods - internal logic
   */
  private validateData(data: DataType): void {
    if (!data.required) {
      throw new Error('Required field missing');
    }
  }

  private async processData(data: DataType): Promise<ProcessedData> {
    // Processing logic
    return processedData;
  }
}

// Export singleton instance
export const serviceName = new ServiceName(repositoryInstance);
```

