## ⚡ Performance Optimization

### Component Memoization
```typescript
// ✅ Memoize components that render frequently with same props
export const PlayerCard = React.memo<PlayerCardProps>(
  ({ player, onPress }) => {
    return (
      <TouchableOpacity onPress={() => onPress(player.id)}>
        <Text>{player.name}</Text>
      </TouchableOpacity>
    );
  },
  // Optional custom comparison
  (prevProps, nextProps) => {
    return prevProps.player.id === nextProps.player.id &&
           prevProps.player.name === nextProps.player.name;
  }
);
```

### Callback Memoization
```typescript
// ✅ Use useCallback for functions passed to child components
const handlePlayerPress = useCallback((playerId: string) => {
  navigation.navigate('PlayerDetail', { playerId });
}, [navigation]);

// ✅ Include ALL dependencies
const handleSpin = useCallback(() => {
  if (!isSpinning && players.length > 0) {
    startSpin();
  }
}, [isSpinning, players.length, startSpin]); // All deps listed
```

### Value Memoization
```typescript
// ✅ Use useMemo for expensive computations
const sortedPlayers = useMemo(() => {
  return [...players].sort((a, b) => b.likes - a.likes);
}, [players]);

const filteredWishes = useMemo(() => {
  return wishes.filter(wish => 
    enabledCategories.includes(wish.category)
  );
}, [wishes, enabledCategories]);
```

### useEffect Cleanup
```typescript
// ✅ Always cleanup subscriptions and timers
useEffect(() => {
  const timer = setTimeout(() => {
    setShowResult(true);
  }, 1000);

  return () => clearTimeout(timer); // Cleanup
}, []);

useEffect(() => {
  const subscription = eventEmitter.addListener('event', handler);
  
  return () => {
    subscription.remove(); // Cleanup
  };
}, []);
```

### Animation Performance
```typescript
// ✅ Use native driver for transforms and opacity
const animatedStyle = {
  transform: [
    {
      rotate: rotationValue.interpolate({
        inputRange: [0, 360],
        outputRange: ['0deg', '360deg'],
      }),
    },
  ],
  opacity: opacityValue,
};

// ❌ Cannot use native driver for layout properties
// width, height, padding, margin, etc.
```

